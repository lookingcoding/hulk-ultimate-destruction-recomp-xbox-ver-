+            LOGI("audio: output starved, queueing %u ms", dev.depth * 10);
+        }
+        if (st.BuffersQueued >= dev.depth) {
+            if (!dev.playing) {
+                HRESULT hr = dev.voice->Start();
+                if (FAILED(hr)) {
+                    lose("source voice start failed", hr);
+                    continue;
                 }
-                Sleep(2);
-                continue;
+                dev.playing = true;
+                dev.progressed = now;
+                LOGI("audio: output started with %u ms buffered", dev.depth * 10);
             }
-            float* b = &bufs[(n % kSlots) * kFrames * 2];
-            render(b, kFrames);
-            XAUDIO2_BUFFER xb{};
-            xb.AudioBytes = kFrames * 8;
-            xb.pAudioData = reinterpret_cast<const BYTE*>(b);
-            hr = voice->SubmitSourceBuffer(&xb);
-            if (FAILED(hr)) {
-                LOGE("audio: buffer submission failed (%08X)", unsigned(hr));
-                return;
-            }
-            n++;  // only a submitted buffer takes a slot, XAudio2 still reads the queued ones
+            Sleep(2);
