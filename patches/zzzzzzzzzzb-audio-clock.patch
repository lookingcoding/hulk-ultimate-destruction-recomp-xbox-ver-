+void Run(const std::function<void(float*, uint32_t)>& render, bool use_device) {
+    CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+    std::vector<float> bufs(kSlots * kFrames * 2);
+    Device dev;
+    bool open = false;
+    auto retry = kFirstRetry;
+    Clock::time_point next_try = Clock::now();
+    Clock::time_point silent = Clock::now();  // how far the mixer has rendered with no device
+    auto lose = [&](const char* why, HRESULT hr) {
+        LOGW("audio: %s (%08X); the game's sound keeps running silently, trying the device again in %lld s", why,
+             unsigned(hr), (long long)(retry.count() / 1000));
+        dev.Close();
+        open = false;
+        silent = Clock::now();
+        next_try = silent + retry;
+        retry = std::min(retry * 2, kLastRetry);
+    };
+    for (uint32_t n = 0;;) {
+        Clock::time_point now = Clock::now();
+        if (!open && use_device && now >= next_try) {
+            HRESULT hr = dev.Open();
+            if (SUCCEEDED(hr)) {
+                open = true;
+                dev.progressed = now;
+            } else {
+                lose("no sound device", hr);
             }
-            if (st.BuffersQueued >= depth) {
-                if (!playing) {
-                    hr = voice->Start();
-                    if (FAILED(hr)) {
-                        LOGE("audio: source voice start failed (%08X)", unsigned(hr));
-                        return;
-                    }
-                    playing = true;
-                    LOGI("audio: output started with %u ms buffered", depth * 10);
+        }
+        if (!open) {
+            // no device: render into nothing at the device's rate, 10 ms at a time
+            float* b = bufs.data();
+            for (int i = 0; i < 10 && silent + kBuffer <= now; i++, silent += kBuffer) render(b, kFrames);
+            if (now - silent > milliseconds(100)) silent = now - milliseconds(100);  // never rush to catch up
+            std::this_thread::sleep_until(std::min(silent + kBuffer, use_device ? next_try : silent + kBuffer));
+            continue;
+        }
+        if (HRESULT hr = dev.engine.error; FAILED(hr)) {
+            lose("sound device lost", hr);
+            continue;
+        }
+        XAUDIO2_VOICE_STATE st;
+        dev.voice->GetState(&st, 0);
+        if (st.SamplesPlayed != dev.played) {
+            dev.played = st.SamplesPlayed;
+            dev.progressed = now;
+            retry = kFirstRetry;  // a device that plays is a working one
+        } else if (dev.playing && now - dev.progressed > kStalled) {
+            lose("sound device stopped playing", E_FAIL);
+            continue;
+        }
+        // a starved voice crackles: queue one buffer more each time, up to kMaxQueued
+        if (dev.playing && !st.BuffersQueued && dev.depth < kMaxQueued) {
