+using Clock = std::chrono::steady_clock;
+using std::chrono::milliseconds;
+
+// Everything the game knows about time in sound comes from the mixer: where a sound is, whether it has finished,
+// when a stream's packets complete. Scripts wait on those (the tutorial's voice lines before its objectives and
+// rewards), so the mixer has to keep running in real time even when no sound device takes its output: none at
+// start, one lost later (unplugged, the default device changed, the engine's critical error) or one that stops
+// asking for sound. Then it renders into nothing at the same rate and tries the device again now and then.
+constexpr uint32_t kFrames = kRate / 100;  // 10 ms a buffer
+constexpr auto kBuffer = milliseconds(10);
+constexpr uint32_t kMinQueued = 3;
+constexpr uint32_t kMaxQueued = 10;
+// one slot more than can be queued, so the one rendered is never one XAudio2 still reads
+constexpr uint32_t kSlots = kMaxQueued + 1;
+constexpr auto kStalled = milliseconds(500);  // a started voice that plays nothing for this long is lost
+constexpr auto kFirstRetry = milliseconds(2000), kLastRetry = milliseconds(30000);
+
+struct Engine : IXAudio2EngineCallback {
+    std::atomic<HRESULT> error{S_OK};
+    void STDMETHODCALLTYPE OnProcessingPassStart() noexcept override {}
+    void STDMETHODCALLTYPE OnProcessingPassEnd() noexcept override {}
+    void STDMETHODCALLTYPE OnCriticalError(HRESULT hr) noexcept override { error = FAILED(hr) ? hr : E_FAIL; }
+};
