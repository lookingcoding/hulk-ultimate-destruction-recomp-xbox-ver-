+void D3D11Backend::RenderUi() {
+    if (!ui_) return;
+    std::lock_guard lock(app::UiLock());
+    ImGui_ImplDX11_NewFrame();
+    ImGui_ImplWin32_NewFrame();
+    ImGui::NewFrame();
+    if (app::kGame.ui) app::kGame.ui(fps_);
+    ImGui::Render();
+    ImGui_ImplDX11_RenderDrawData(ImGui::GetDrawData());
+    binds_ = {};
+}
+
+void D3D11Backend::DrawFrame(Target* t) {
+    float black[4] = {0, 0, 0, 1};
+    ID3D11ShaderResourceView* none[4] = {};
+    ctx_->PSSetShaderResources(0, 4, none);
+    ctx_->ClearRenderTargetView(bb_rtv_.Get(), black);
+    ID3D11RenderTargetView* rtv = bb_rtv_.Get();
+    ctx_->OMSetRenderTargets(1, &rtv, nullptr);
+    bound_rt_ = bound_ds_ = nullptr;
+    if (t) BlitFrame(*t);
+    RenderUi();
+}
+
+void D3D11Backend::ReleaseOldTextures() {
+    constexpr uint64_t kSweepEvery = 60;
+    constexpr size_t kTexturesKept = 2048;
+    constexpr uint64_t kIdleFrames = 600;
+    if (presents_ % kSweepEvery != 0 || textures_.size() <= kTexturesKept) return;
+    for (auto it = textures_.begin(); it != textures_.end();) {
+        if (it->second.frame + kIdleFrames < presents_) {
+            it = textures_.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+void D3D11Backend::CountFps() {
+    fps_n_++;
+    auto now = std::chrono::steady_clock::now();
+    double el = std::chrono::duration<double>(now - fps_t_).count();
+    if (el >= 0.5) {
+        fps_ = fps_n_ / el;
+        fps_n_ = 0;
+        fps_t_ = now;
+    }
+}
+
+void LogPerf() {
+    static PerfClock::time_point perf_start = PerfClock::now();
+    static uint64_t perf_frames = 0;
+    perf_frames++;
+    double el = PerfMs(perf_start);
+    if (el < 1000.0) return;
+    Perf& p = g_perf;
+    double n = double(perf_frames);
+    double host = p.draw + p.clear + p.copy + p.present + p.sync;
+    LOGI("perf: %.1f fps %.2f ms/frame | host %.2f (draw %.2f: assemble %.2f bind %.2f [check %.2f, upload %.2f] "
+         "compile %.2f; clear %.2f copy %.2f sync %.2f present %.2f [swap %.2f]) other %.2f",
+         n * 1000.0 / el, el / n, host / n, p.draw / n, p.assemble / n, p.bind / n, p.sig / n, p.texup / n,
+         p.compile / n, p.clear / n, p.copy / n, p.sync / n, p.present / n, p.swap / n, (el - host) / n);
+    LOGI("perf: title thread per frame: recording %.2f ms, waiting %.2f ms (%.1f waits)",
+         g_perf_capture_ns.exchange(0) / n / 1e6, g_perf_wait_ns.exchange(0) / n / 1e6, g_perf_waits.exchange(0) / n);
+    LOGI("perf: per frame %.0f draws (%.0f raw) %.0fk verts %.1f MB upload %.1f overflow | %.1f tex uploads %.2f MB, "
+         "%.1f new tex, %.1f new targets, %.1f target uploads, %.1f shrinks, %.1f read-backs %.1f late | %llu shaders "
+         "%llu pipelines this second",
+         p.draws / n, p.raw / n, p.verts / n / 1000.0, p.upload / n / 1048576.0, p.overflow / n, p.texups / n,
+         p.texup_bytes / n / 1048576.0, p.newtex / n, p.targets / n, p.rtups / n, p.shrinks / n, p.syncs / n,
+         p.lates / n, (unsigned long long)p.shaders, (unsigned long long)p.psos);
+    g_perf = Perf{};
+    perf_start = PerfClock::now();
+    perf_frames = 0;
+}
+
+void D3D11Backend::Present(const Surface& front) {
+    std::lock_guard lock(ctx_lock_);
+    PerfScope perf_present{g_perf.present};
+    if (cap_) {
+        FinishCapture(front);
+    } else if (g_capture.exchange(false) && CaptureOn()) {
+        StartCapture();
+    }
+    ResizeSwap();
+    Target* t = EnsureTarget(front, false);
+    if (t && LatchCpuWrite(*t)) UploadTarget(*t, front);
+    if (ramp_dirty_) UploadGammaRamp();
+    DrawFrame(t);
+    DeliverReports();
+    bool vsync = app::Get().vsync;
+    auto perf_swap = PerfClock::now();
+    swap_->Present(vsync ? 1 : 0, !vsync && tearing_ ? DXGI_PRESENT_ALLOW_TEARING : 0);
+    g_perf.swap += PerfMs(perf_swap);
+    // the flip model unbinds the back buffer
+    bound_rt_ = bound_ds_ = nullptr;
+    oversized_.clear();
+    presents_++;
+    presents_seen_.store(presents_);
+    frame_++;
+    ReleaseOldTextures();
+    CountFps();
+    if (diag::Perf()) LogPerf();
+    ApplySettings();
+}
+
+void D3D11Backend::ApplySettings() {
+    if (texturedumper::Update()) pack_textures_.clear();
+    float want = app::RenderScale(guest_h_);
+    if (std::fabs(want - scale_) > 1e-4f) {
+        ctx_->OMSetRenderTargets(0, nullptr, nullptr);
+        ID3D11ShaderResourceView* none[4] = {};
+        ctx_->PSSetShaderResources(0, 4, none);
+        targets_.clear();
+        late_.clear();
+        scale_ = want;
+        bound_rt_ = bound_ds_ = nullptr;
+    }
+}
+
+bool D3D11Backend::TargetStale(uint32_t data) const {
+    auto it = target_used_.find(data);
+    uint64_t used = it == target_used_.end() ? 0 : it->second;
+    return frame_ - used > kStaleFrames;
+}
+
+// filters src into a w x h BGRA texture, into when given, else a new one
+ComPtr<ID3D11Texture2D> D3D11Backend::Shrink(ID3D11ShaderResourceView* src, uint32_t w, uint32_t h, uint32_t taps,
+                                             float mul, ID3D11Texture2D* into) {
+    g_perf.shrinks++;
+    ComPtr<ID3D11Texture2D> down = into;
+    if (!down) {
+        D3D11_TEXTURE2D_DESC td{w, h, 1, 1, kBgra, {1, 0}, D3D11_USAGE_DEFAULT,
+                                D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE, 0, 0};
+        if (FAILED(dev_->CreateTexture2D(&td, nullptr, &down))) return nullptr;
+    }
+    ComPtr<ID3D11RenderTargetView> rtv;
+    if (FAILED(dev_->CreateRenderTargetView(down.Get(), nullptr, &rtv))) return nullptr;
+    SetBlitTarget(rtv.Get(), w, h);
+    float uv[4] = {0, 0, 1, 1};
+    Blit(src, uv, {.alpha = true, .taps = taps, .mul = mul});
+    return down;
+}
+
+// the target as a guest sized BGRA texture: itself, or shrunk into a copy
+ComPtr<ID3D11Texture2D> D3D11Backend::CopySource(Target& t, ID3D11Texture2D* into) {
+    if (t.w != t.gw || t.h != t.gh || t.fmt != kBgra) return Shrink(t.srv.Get(), t.gw, t.gh, 1, 1, into);
+    return t.res;
+}
+
+// a BGRA texture to the CPU, rows packed; waits for the GPU
+bool D3D11Backend::ReadBack(ID3D11Texture2D* res, uint32_t w, uint32_t h, std::vector<uint8_t>& out) {
+    D3D11_TEXTURE2D_DESC td{w, h, 1, 1, kBgra, {1, 0}, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0};
+    ComPtr<ID3D11Texture2D> rb;
+    if (FAILED(dev_->CreateTexture2D(&td, nullptr, &rb))) return false;
+    D3D11_BOX box{0, 0, 0, w, h, 1};
+    ctx_->CopySubresourceRegion(rb.Get(), 0, 0, 0, 0, res, 0, &box);
+    D3D11_MAPPED_SUBRESOURCE m;
+    if (FAILED(ctx_->Map(rb.Get(), 0, D3D11_MAP_READ, 0, &m))) return false;
+    out.resize(size_t(w) * h * 4);
+    for (uint32_t y = 0; y < h; y++) {
+        std::memcpy(&out[size_t(y) * w * 4], static_cast<const uint8_t*>(m.pData) + size_t(y) * m.RowPitch, w * 4);
+    }
+    ctx_->Unmap(rb.Get(), 0);
+    return true;
+}
+
+// the CPU reads a surface the GPU drew: bring the pixels back
+void D3D11Backend::Sync(uint32_t data, uint32_t) {
+    std::lock_guard lock(ctx_lock_);
+    auto it = targets_.find(TargetMapKey(data, false));
+    if (it == targets_.end() || !it->second.drawn || TargetStale(data)) return;
+    PerfScope perf_sync{g_perf.sync};
+    g_perf.syncs++;
+    Target& t = it->second;
+    ComPtr<ID3D11Texture2D> src = CopySource(t);
+    std::vector<uint8_t> px;
+    if (!src || !ReadBack(src.Get(), t.gw, t.gh, px)) return;
+    uint32_t pitch = GuestPitch(t.gw);
+    uint8_t* guest = static_cast<uint8_t*>(kernel::HostPtr(data));
+    for (uint32_t y = 0; y < t.gh; y++) std::memcpy(guest + size_t(y) * pitch, &px[size_t(y) * t.gw * 4], t.gw * 4);
+    t.read = std::move(px);
+    t.drawn = false;
+    t.sig = MemSig(t.data, t.bytes);
+}
+
+void D3D11Backend::SyncLate(uint32_t data) {
+    if (!DeliverLate(data)) Sync(data, 0);
+    RecordLate(data);
+}
+
+// the newest finished copy of a surface locked without a wait, into guest memory; false when none is
+bool D3D11Backend::DeliverLate(uint32_t data) {
+    std::lock_guard ctx_lock(ctx_lock_);
+    std::lock_guard lock(late_lock_);
+    auto it = late_.find(data);
+    if (it == late_.end()) return false;
+    Late& l = it->second;
+    uint64_t now = presents_seen_.load();
+    int best = -1;
+    for (int i = 0; i < kLateSlots; i++) {
+        bool finished = l.seq[i] && l.done[i] && ctx_->GetData(l.done[i].Get(), nullptr, 0, D3D11_ASYNC_GETDATA_DONOTFLUSH) == S_OK;
+        bool recent = now - l.frame[i] <= uint64_t(kLateSlots) + 1;
+        bool newest = best < 0 || l.seq[i] > l.seq[best];
+        if (finished && recent && newest) best = i;
+    }
+    if (best < 0) return false;
+    if (l.seq[best] > l.delivered) {
+        D3D11_MAPPED_SUBRESOURCE m;
+        if (FAILED(ctx_->Map(l.rb[best].Get(), 0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &m))) return false;
+        uint32_t pitch = GuestPitch(l.gw);
+        uint8_t* dst = static_cast<uint8_t*>(kernel::HostPtr(data));
+        for (uint32_t y = 0; y < l.gh; y++) {
+            std::memcpy(dst + size_t(y) * pitch, static_cast<const uint8_t*>(m.pData) + size_t(y) * m.RowPitch, l.gw * 4);
+        }
+        ctx_->Unmap(l.rb[best].Get(), 0);
+        l.delivered = l.seq[best];
+    }
+    return true;
+}
+
+void D3D11Backend::RecordLateCopy(Late& l, uint32_t slot, ID3D11Texture2D* src) {
+    if (!l.rb[slot]) {
+        D3D11_TEXTURE2D_DESC td{l.gw, l.gh, 1, 1, kBgra, {1, 0}, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, 0};
+        D3D11_QUERY_DESC qd{D3D11_QUERY_EVENT, 0};
+        if (FAILED(dev_->CreateTexture2D(&td, nullptr, &l.rb[slot])) || FAILED(dev_->CreateQuery(&qd, &l.done[slot]))) {
+            l.rb[slot].Reset();
+            return;
+        }
+    }
+    D3D11_BOX box{0, 0, 0, l.gw, l.gh, 1};
+    ctx_->CopySubresourceRegion(l.rb[slot].Get(), 0, 0, 0, 0, src, 0, &box);
+    ctx_->End(l.done[slot].Get());
+    l.seq[slot] = ++late_seq_;
+    l.frame[slot] = presents_;
+    l.next = (slot + 1) % kLateSlots;
+}
+
+void D3D11Backend::RecordLate(uint32_t data) {
+    std::lock_guard ctx_lock(ctx_lock_);
+    auto it = targets_.find(TargetMapKey(data, false));
+    if (it == targets_.end() || TargetStale(data)) return;
+    Target& t = it->second;
+    PerfScope perf_sync{g_perf.sync};
+    g_perf.lates++;
+    t.sig = MemSig(t.data, t.bytes);
+    t.read.clear();
+    std::lock_guard lock(late_lock_);
+    Late& l = late_[data];
+    if (l.gw != t.gw || l.gh != t.gh) {
+        l = Late{};
+        l.gw = t.gw;
+        l.gh = t.gh;
+    }
+    // a copy for a later lock, unless the GPU is a whole ring behind
+    uint32_t slot = l.next;
+    if (l.seq[slot] && ctx_->GetData(l.done[slot].Get(), nullptr, 0, D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK) return;
+    ComPtr<ID3D11Texture2D> src = CopySource(t, l.down.Get());
+    if (!src) return;
+    if (src != t.res) l.down = src;
+    RecordLateCopy(l, slot, src.Get());
+}
+
+void D3D11Backend::CapSave(ID3D11ShaderResourceView* srv, uint32_t w, uint32_t h, const char* name) {
+    if (!srv) return;
+    ComPtr<ID3D11Texture2D> down = Shrink(srv, w, h, 1, 1);
+    std::vector<uint8_t> px;
+    if (!down || !ReadBack(down.Get(), w, h, px)) return;
+    FILE* f = _wfopen((cap_dir_ / (std::string(name) + ".bmp")).c_str(), L"wb");
+    if (!f) return;
+    uint8_t hd[54] = {'B', 'M'};  // BITMAPFILEHEADER and BITMAPINFOHEADER, top down 32 bit
+    auto put = [&](int o, uint32_t v) { std::memcpy(hd + o, &v, 4); };
+    put(2, 54 + uint32_t(px.size()));
+    put(10, 54);
+    put(14, 40);
+    put(18, w);
+    put(22, uint32_t(-int32_t(h)));
+    hd[26] = 1;
+    hd[28] = 32;
+    put(34, uint32_t(px.size()));
+    fwrite(hd, 1, sizeof(hd), f);
+    fwrite(px.data(), 1, px.size(), f);
+    fclose(f);
+}
+
+void D3D11Backend::CapStep(const Surface& rt) {
+    uint32_t d = rt.header ? mem::VirtualFromPhysical(rt.data) : 0;
+    if (d == cap_rt_) return;
+    auto it = targets_.find(TargetMapKey(cap_rt_, false));
+    if (cap_rt_ && it != targets_.end()) {
+        char name[32];
+        snprintf(name, sizeof(name), "%04u_%08X", cap_i_, cap_rt_);
+        CapSave(it->second, name);
+    }
+    auto z = targets_.find(TargetMapKey(cap_rt_, true));
+    if (cap_rt_ && z != targets_.end()) {
+        char name[32];
+        snprintf(name, sizeof(name), "%04u_%08X_z", cap_i_, cap_rt_);
+        CapSave(z->second, name);
+    }
+    cap_rt_ = d;
+}
+
+void D3D11Backend::SetGamma(const uint8_t* ramp) {
+    std::lock_guard lock(ctx_lock_);
+    std::memcpy(ramp_, ramp, sizeof(ramp_));
+    ramp_dirty_ = true;
+}
