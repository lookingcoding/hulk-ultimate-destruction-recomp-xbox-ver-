@@ -0,0 +1,2976 @@
+// The title's Direct3D 8 calls drawn with Direct3D 11: the renderer for graphics cards and drivers without Direct3D 12
+// (d3d8.cpp falls back to it, XBE_RENDERER=d3d11 asks for it). It follows d3d12.cpp step for step with the same
+// shaders; what Direct3D 11 does for it (resource states, descriptor heaps, upload rings, fences) drops out, and what
+// it lacks (rect clears, pipeline objects) is done by draws and state objects. Renderer extensions are D3D12 only.
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <d3d11.h>
+#include <d3dcompiler.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cfloat>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <mutex>
+#include <optional>
+#include <unordered_map>
+#include <unordered_set>
+
+#include <imgui.h>
+#include <backends/imgui_impl_dx11.h>
+#include <backends/imgui_impl_win32.h>
+
+#include "app/app.h"
+#include "core/diag.h"
+#include "core/log.h"
+#include "gpu/backend.h"
+#include "gpu/shaders.h"
+#include "gpu/texture.h"
+#include "gpu/texturedumper.h"
+#include "gpu/vertex.h"
+#include "kernel/kernel.h"
+
+using Microsoft::WRL::ComPtr;
+
+namespace gpu {
+
+namespace {
+
+constexpr uint64_t kStaleFrames = 8;  // frames a target may go unused and still be read back
+constexpr uint32_t kVertexRing = 64u << 20;
+constexpr uint32_t kIndexRing = 16u << 20;
+constexpr uint32_t kPassConstants = 256;
+constexpr DXGI_FORMAT kBgra = DXGI_FORMAT_B8G8R8A8_UNORM;
+constexpr uint32_t kQueries = 8192;  // occlusion queries in flight, several frames of counted draws
+constexpr uint32_t kNoQuery = ~0u;
+constexpr int kLateSlots = 3;        // read-back copies in flight per surface locked without a wait
+
+using PerfClock = std::chrono::steady_clock;
+double PerfMs(PerfClock::time_point t) {
+    return std::chrono::duration<double, std::milli>(PerfClock::now() - t).count();
+}
+struct Perf {
+    double draw = 0, assemble = 0, bind = 0, sig = 0, texup = 0, compile = 0, clear = 0, copy = 0, present = 0,
+           wait = 0, swap = 0, sync = 0;
+    uint64_t draws = 0, verts = 0, upload = 0, overflow = 0, sigs = 0, sig_bytes = 0, texups = 0, texup_bytes = 0,
+             newtex = 0, targets = 0, rtups = 0, shrinks = 0, syncs = 0, psos = 0, shaders = 0, raw = 0, lates = 0;
+};
+Perf g_perf;
+struct PerfScope {
+    double& acc;
+    bool on = diag::Perf();
+    PerfClock::time_point t = on ? PerfClock::now() : PerfClock::time_point{};
+    ~PerfScope() {
+        if (on) acc += PerfMs(t);
+    }
+};
+
+bool CaptureOn() {
+    if (diag::CaptureDir().empty()) LOG_FIRST(1, "capture: set XBE_CAPTURE_DIR");
+    return !diag::CaptureDir().empty();
+}
+
+// d3d12.cpp's passes, as they are
+const char* kBlitHlsl = R"(
+cbuffer B : register(b1) { float4 uvrect; float4 opts; };
+Texture2D img : register(t0);
+Texture2D lut : register(t1);
+SamplerState ls : register(s0);
+SamplerState ps : register(s1);
+struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };
+O vs(uint id : SV_VertexID) {
+    O o;
+    float2 t = float2((id << 1) & 2, id & 2);
+    o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1);
+    o.uv = uvrect.xy + t * uvrect.zw;
+    return o;
+}
+float4 psmain(O i) : SV_Target {
+    float4 c = 0;
+    int n = max((int)opts.z, 1);
+    float2 px = fwidth(i.uv);
+    for (int y = 0; y < n; y++)
+        for (int x = 0; x < n; x++) c += img.SampleLevel(ls, i.uv + px * ((float2(x, y) + 0.5) / n - 0.5), 0);
+    c /= n * n;
+    c.rgb *= opts.w;
+    if (opts.x > 0) c.rgb = float3(lut.Sample(ps, float2(c.r, 0.5)).r, lut.Sample(ps, float2(c.g, 0.5)).g, lut.Sample(ps, float2(c.b, 0.5)).b);
+    return float4(c.rgb, opts.y > 0 ? c.a : 1);
+}
+)";
+
+// depth is reversed in a 32 bit float buffer, as in d3d12.cpp
+constexpr DXGI_FORMAT kDepthTypeless = DXGI_FORMAT_R32G8X24_TYPELESS;
+constexpr DXGI_FORMAT kDepthFormat = DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
+constexpr DXGI_FORMAT kDepthRead = DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS;
+constexpr float kDepthFar = 0;
+
+const char* kDepthHlsl = R"(
+Texture2D<float> img : register(t0);
+SamplerState ps : register(s1);
+struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };
+O vs(uint id : SV_VertexID) {
+    O o;
+    o.uv = float2((id << 1) & 2, id & 2);
+    o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);
+    return o;
+}
+float psmain(O i) : SV_Depth { return img.SampleLevel(ps, i.uv, 0); }
+)";
+
+const char* kClearHlsl = R"(
+cbuffer B : register(b1) { float4 colour; };
+float4 vs(uint id : SV_VertexID) : SV_Position {
+    float2 t = float2((id << 1) & 2, id & 2);
+    return float4(t * float2(2, -2) + float2(-1, 1), 0, 1);
+}
+float4 psmain() : SV_Target { return colour; }
+float depthmain() : SV_Depth { return colour.x; }
+)";
+
+float Bits(uint32_t v) {
+    float f;
+    std::memcpy(&f, &v, 4);
+    return f;
+}
+
+void Color(uint32_t argb, float* o) {
+    o[0] = ((argb >> 16) & 255) / 255.0f;
+    o[1] = ((argb >> 8) & 255) / 255.0f;
+    o[2] = (argb & 255) / 255.0f;
+    o[3] = (argb >> 24) / 255.0f;
+}
+
+// D3DBLEND, the console uses GL values
+constexpr uint32_t kBlendDestColor = 0x306;
+
+D3D11_BLEND Blend(uint32_t v, bool alpha) {
+    switch (v) {
+        case 0: return D3D11_BLEND_ZERO;
+        case 1: return D3D11_BLEND_ONE;
+        case 0x300: return alpha ? D3D11_BLEND_SRC_ALPHA : D3D11_BLEND_SRC_COLOR;
+        case 0x301: return alpha ? D3D11_BLEND_INV_SRC_ALPHA : D3D11_BLEND_INV_SRC_COLOR;
+        case 0x302: return D3D11_BLEND_SRC_ALPHA;
+        case 0x303: return D3D11_BLEND_INV_SRC_ALPHA;
+        case 0x304: return D3D11_BLEND_DEST_ALPHA;
+        case 0x305: return D3D11_BLEND_INV_DEST_ALPHA;
+        case kBlendDestColor: return alpha ? D3D11_BLEND_DEST_ALPHA : D3D11_BLEND_DEST_COLOR;
+        case 0x307: return alpha ? D3D11_BLEND_INV_DEST_ALPHA : D3D11_BLEND_INV_DEST_COLOR;
+        case 0x308: return D3D11_BLEND_SRC_ALPHA_SAT;
+        case 0x8001: case 0x8003: return D3D11_BLEND_BLEND_FACTOR;
+        case 0x8002: case 0x8004: return D3D11_BLEND_INV_BLEND_FACTOR;
+        default: return D3D11_BLEND_ONE;
+    }
+}
+
+D3D11_BLEND_OP BlendOp(uint32_t v) {
+    switch (v) {
+        case 0x800A: return D3D11_BLEND_OP_SUBTRACT;
+        case 0x800B: return D3D11_BLEND_OP_REV_SUBTRACT;
+        case 0x8007: return D3D11_BLEND_OP_MIN;
+        case 0x8008: return D3D11_BLEND_OP_MAX;
+        default: return D3D11_BLEND_OP_ADD;
+    }
+}
+
+// D3DCMP_NEVER 0x200 to D3DCMP_ALWAYS 0x207, D3D11's order from 1
+D3D11_COMPARISON_FUNC Cmp(uint32_t v) {
+    uint32_t n = v >= 0x200 && v <= 0x207 ? v - 0x200 : 7;
+    return D3D11_COMPARISON_FUNC(n + 1);
+}
+
+D3D11_STENCIL_OP StencilOp(uint32_t v) {
+    switch (v) {
+        case 0: return D3D11_STENCIL_OP_ZERO;
+        case 0x1E01: return D3D11_STENCIL_OP_REPLACE;
+        case 0x1E02: return D3D11_STENCIL_OP_INCR_SAT;
+        case 0x1E03: return D3D11_STENCIL_OP_DECR_SAT;
+        case 0x150A: return D3D11_STENCIL_OP_INVERT;
+        case 0x8507: return D3D11_STENCIL_OP_INCR;
+        case 0x8508: return D3D11_STENCIL_OP_DECR;
+        default: return D3D11_STENCIL_OP_KEEP;
+    }
+}
+
+D3D11_TEXTURE_ADDRESS_MODE Address(uint32_t v) {
+    switch (v) {
+        case 2: return D3D11_TEXTURE_ADDRESS_MIRROR;
+        case 3: case 5: return D3D11_TEXTURE_ADDRESS_CLAMP;
+        case 4: return D3D11_TEXTURE_ADDRESS_BORDER;
+        default: return D3D11_TEXTURE_ADDRESS_WRAP;
+    }
+}
+
+DXGI_FORMAT HostFormat(Host h) {
+    switch (h) {
+        case Host::BC1: return DXGI_FORMAT_BC1_UNORM;
+        case Host::BC2: return DXGI_FORMAT_BC2_UNORM;
+        case Host::BC3: return DXGI_FORMAT_BC3_UNORM;
+        case Host::R32F: return DXGI_FORMAT_R32_FLOAT;
+        default: return DXGI_FORMAT_B8G8R8A8_UNORM;
+    }
+}
+
+// a format's texel blocks: 4x4 and 8 or 16 bytes for the block compressed ones, else one 4 byte texel
+struct Blocks {
+    uint32_t side;
+    uint32_t bytes;
+};
+Blocks FormatBlocks(DXGI_FORMAT f) {
+    switch (f) {
+        case DXGI_FORMAT_BC1_UNORM: case DXGI_FORMAT_BC1_UNORM_SRGB: case DXGI_FORMAT_BC4_UNORM:
+        case DXGI_FORMAT_BC4_SNORM: return {4, 8};
+        case DXGI_FORMAT_BC2_UNORM: case DXGI_FORMAT_BC2_UNORM_SRGB: case DXGI_FORMAT_BC3_UNORM:
+        case DXGI_FORMAT_BC3_UNORM_SRGB: case DXGI_FORMAT_BC5_UNORM: case DXGI_FORMAT_BC5_SNORM:
+        case DXGI_FORMAT_BC6H_UF16: case DXGI_FORMAT_BC6H_SF16: case DXGI_FORMAT_BC7_UNORM:
+        case DXGI_FORMAT_BC7_UNORM_SRGB: return {4, 16};
+        default: return {1, 4};
+    }
+}
+
+constexpr uint32_t kFmtD16 = 0x2C;     // D3DFMT_D16
+constexpr uint32_t kFmtLinD16 = 0x30;  // D3DFMT_LIN_D16
+
+uint8_t ShadowDepthKind(uint32_t format) { return format == kFmtD16 || format == kFmtLinD16 ? 2 : 1; }
+
+uint32_t GuestPitch(uint32_t width) { return (width * 4 + 63) & ~63u; }
+
+constexpr uint32_t kSigWholeMax = 65536;
+constexpr uint32_t kSigSamples = 64;
+constexpr uint32_t kSigSampleBytes = 64;
+
+uint64_t MemSig(uint32_t data, uint32_t total) {
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(data));
+    uint64_t sig = Hash(&total, sizeof(total));
+    g_perf.sigs++;
+    g_perf.sig_bytes += total <= kSigWholeMax ? total : kSigSamples * kSigSampleBytes;
+    if (total <= kSigWholeMax) return Hash(p, total, sig);
+    for (uint32_t i = 0; i < kSigSamples; i++) {
+        const uint8_t* sample = p + uint64_t(total - kSigSampleBytes) * i / (kSigSamples - 1);
+        sig = Hash(sample, kSigSampleBytes, sig);
+    }
+    return sig;
+}
+
+// a console surface the renderer draws into
+struct Target {
+    ComPtr<ID3D11Texture2D> res;
+    ComPtr<ID3D11RenderTargetView> rtv;
+    ComPtr<ID3D11DepthStencilView> dsv;
+    ComPtr<ID3D11ShaderResourceView> srv;
+    bool depth = false;
+    uint32_t gw = 0, gh = 0, w = 0, h = 0;
+    uint32_t data = 0, bytes = 0;
+    uint64_t epoch = 0, sig = 0;
+    bool drawn = false;
+    std::vector<uint8_t> read;
+    ComPtr<ID3D11Texture2D> fb;  // copy read by draws that sample the target they render to
+    ComPtr<ID3D11ShaderResourceView> fb_srv;
+    DXGI_FORMAT fmt = kBgra;
+};
+
+bool Changed(const Target& t) {
+    if (t.drawn || t.read.empty()) return false;
+    uint32_t row = t.gw * 4;
+    uint32_t pitch = GuestPitch(t.gw);
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(t.data));
+    for (uint32_t y = 0; y < t.gh; y++) {
+        if (std::memcmp(p + size_t(y) * pitch, &t.read[size_t(y) * row], row)) return true;
+    }
+    return false;
+}
+
+bool LatchCpuWrite(Target& t) {
+    uint64_t e = DirtyEpoch(t.data);
+    if (e <= t.epoch) return false;
+    t.epoch = e;
+    uint64_t sig = MemSig(t.data, t.bytes);
+    if (sig == t.sig && !Changed(t)) return false;
+    t.sig = sig;
+    return true;
+}
+
+struct Tex {
+    ComPtr<ID3D11Resource> res;
+    ComPtr<ID3D11ShaderResourceView> srv;
+    TextureDesc d;
+    DXGI_FORMAT fmt = DXGI_FORMAT_UNKNOWN;
+    uint32_t w = 0, h = 0, slices = 1;  // the host texture's top level, slices of a volume
+    uint32_t levels = 1;
+    uint64_t sig = 0;
+    uint64_t frame = 0;
+    uint64_t palette = 0;
+    const Tex* swap = nullptr;
+    uint64_t pack_key = 0;
+    uint32_t pack_gen = 0;
+};
+
+struct PsoKey {
+    uint64_t vs;
+    uint64_t ps;
+    uint32_t regs;
+    uint32_t topo;
+    uint32_t has_rt;
+    uint32_t has_ds;
+    uint32_t elements[16];
+    uint32_t blend;
+    uint32_t src;
+    uint32_t dst;
+    uint32_t op;
+    uint32_t wmask;
+    uint32_t zen;
+    uint32_t zwrite;
+    uint32_t zfunc;
+    uint32_t sten;
+    uint32_t sfunc;
+    uint32_t smask;
+    uint32_t swmask;
+    uint32_t sfail;
+    uint32_t szfail;
+    uint32_t spass;
+    uint32_t cull;
+    uint32_t ccw;
+    uint32_t fill;
+    int32_t zbias;
+    float zslope;
+    uint32_t rtfmt;
+};
+
+// what Direct3D 12 keeps in a pipeline state object
+struct Pipeline {
+    ComPtr<ID3D11InputLayout> il;
+    ComPtr<ID3D11VertexShader> vs;
+    ComPtr<ID3D11PixelShader> ps;
+    ComPtr<ID3D11GeometryShader> gs;
+    ComPtr<ID3D11BlendState> bs;
+    ComPtr<ID3D11RasterizerState> rs;
+    ComPtr<ID3D11DepthStencilState> dss;
+};
+
+struct BlitOptions {
+    bool gamma = false;
+    bool alpha = false;
+    uint32_t taps = 1;
+    float mul = 1;
+    bool over = false;
+};
+
+struct DrawTextures {
+    TexInfo info[4];
+    ID3D11ShaderResourceView* srv[4] = {};
+    uint32_t levels[4] = {1, 1, 1, 1};
+    bool rt[4] = {};
+    float k[4] = {1, 1, 1, 1};
+    float wide[4] = {};
+};
+
+// what the last draw set, so the next one sets only what differs; anything else that sets them clears it
+struct DrawBinds {
+    const Pipeline* pipe = nullptr;
+    D3D11_PRIMITIVE_TOPOLOGY topology = D3D11_PRIMITIVE_TOPOLOGY_UNDEFINED;
+    float blend[4] = {};
+    uint32_t stencil = 0;
+    bool constants = false;  // the draw constant buffers are bound
+};
+
+struct UsedTarget {
+    uint32_t data = 0;
+    uint64_t frame = UINT64_MAX;
+};
+
+struct DrawShaders {
+    bool prog = false;
+    bool quad = false;
+    bool fixed_transform = false;
+    FixedKey fk;
+    uint64_t vkey = 0;
+    uint64_t vh = 0;
+    uint64_t pkey = 0;
+    uint64_t ph = 0;
+    ID3DBlob* vs_code = nullptr;
+    ID3DBlob* ps_code = nullptr;
+};
+
+struct GuestExtent {
+    uint32_t w;
+    uint32_t h;
+};
+
+// a dynamic buffer written front to back, discarded when it fills
+struct Ring {
+    ComPtr<ID3D11Buffer> buf;
+    uint32_t size = 0;
+    uint32_t used = 0;
+};
+
+class D3D11Backend final : public Backend {
+public:
+    ~D3D11Backend() override;
+    bool Init(uint32_t width, uint32_t height) override;
+    void Clear(const State& s, uint32_t count, const uint8_t* rects, uint32_t flags, uint32_t color, float z,
