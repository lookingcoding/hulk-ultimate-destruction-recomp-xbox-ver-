+// a read through the file's view: its own bytes, zeros past its end, then the view's changes
+static uint32_t ReadView(File& f, uint64_t pos, uint32_t buf, uint32_t len, uint32_t pages) {
+    uint64_t size = f.view->size;
+    uint32_t n = pos < size ? uint32_t(std::min<uint64_t>(len, size - pos)) : 0;
+    if (!n) return 0;
+    std::vector<uint8_t> data(n);
+    ReadOwn(f, pos, data.data(), n);
+    f.view->read(pos, data.data(), n);
+    for (uint32_t i = 0; i < n;) {
+        uint32_t at = pages ? R32(pages + i / 0x1000 * 8) + i % 0x1000 : buf + i;
+        uint32_t chunk = pages ? std::min(n - i, 0x1000 - i % 0x1000) : n;
+        std::memcpy(HostPtr(at), data.data() + i, chunk);
+        i += chunk;
+    }
+    return n;
+}
