+// the file's own bytes from pos, from the disc image or the host file
+size_t ReadOwn(File& f, uint64_t pos, void* dst, size_t n) {
+    if (f.entry) return MountedDisc()->Read(*f.entry, pos, dst, n);
+    Seek(f.fp, pos);
+    return std::fread(dst, 1, n, f.fp);
+}
+
+// GameInfo::file: the game's code may change what the game reads of a file opened for reading
+void AttachView(File& f) {
+    if (!app::kGame.file || f.dir || (!f.fp && !f.entry)) return;
+    std::error_code ec;
+    uint64_t size = f.entry ? f.entry->size : fs::file_size(f.host, ec);
+    if (ec) return;
+    f.view = app::kGame.file(f.xbox, size, [&f](uint64_t at, void* dst, size_t n) { return ReadOwn(f, at, dst, n); });
+}
