+void D3D12Backend::ReplaceShaderHeap(ComPtr<ID3D12DescriptorHeap>& heap) {
+    // Never rewrite a shader-visible heap that submitted or recorded draws still read.
+    // Retain the old heap with this frame; its fence also covers earlier queue submissions.
+    const auto desc = heap->GetDesc();
+    ComPtr<ID3D12DescriptorHeap> next;
+    if (FAILED(dev_->CreateDescriptorHeap(&desc, IID_PPV_ARGS(&next)))) {
+        LOGE("d3d12: could not replace descriptor heap");
+        throw std::runtime_error("D3D12 descriptor heap allocation failed");
+    }
+    CurrentFrame().old_heaps.push_back(heap);
+    heap = std::move(next);
+    ID3D12DescriptorHeap* heaps[] = {srv_heap_.Get(), smp_heap_.Get()};
+    cl_->SetDescriptorHeaps(2, heaps);
+    // SetDescriptorHeaps invalidates both root descriptor tables, even if one heap stayed.
+    binds_.views = binds_.samplers = UINT32_MAX;
+    LOG_FIRST(16, "d3d12: retired %s descriptor heap at frame %llu",
+              desc.Type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER ? "sampler" : "SRV",
+              (unsigned long long)presents_);
+}
